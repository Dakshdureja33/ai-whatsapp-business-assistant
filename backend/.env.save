# ========================================
# WhatsApp Business Assistant - Environment
# ========================================

# Application
APP_NAME=WhatsApp Business Assistant
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_assistant.db
DATABASE_SYNC_URL=sqlite:///./whatsapp_assistant.db

# ── Meta / WhatsApp Cloud API ──
# Get these from https://developers.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=whatsapp_verify_token_2024
META_APP_SECRET=your_meta_app_secret

# ── Groq AI (Llama 3.3) ──
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Business Config
BUSINESS_NAME=TechStore Pro
BUSINESS_HOURS=9:00 AM - 6:00 PM
BUSINESS_TIMEZONE=Asia/Kolkata

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
WEBHOOK_URL=https://true-drinks-tickle.loca.lt/api/webhooks
npx -y localtunnel --port 8000 --print-requests &


WEBHOOK_URL=https://bright‑oak‑fish.loca.lt/api/webhooks

cd backend
pkill -f uvicorn || true          # kill any old server
uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 &

cd ../frontend
npm run dev


